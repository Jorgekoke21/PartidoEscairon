---
import { Route, SprayCan, TreePine, Landmark } from 'lucide-astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import PlaceholderPhoto from '../../components/PlaceholderPhoto.astro';
import ProposalAccordion from '../../components/ProposalAccordion.astro';
import ContactForm from '../../components/ContactForm.astro';
import { parishes, getParishProposals } from '../../data/parishes';
import { categories } from '../../data/categories';
import { route } from '../../data/site';

export function getStaticPaths() { return parishes.map((parish) => ({ params: { slug: parish.slug }, props: { parish } })); }
const { parish } = Astro.props;
const parishProposals = getParishProposals(parish);
const groups = categories.map((category) => ({ category, items: parishProposals.filter((proposal) => proposal.category === category.slug) })).filter((group) => group.items.length > 0);
---
<BaseLayout title={`${parish.name}, unha parroquia con futuro · PSOE O Saviñao`} active="/parroquias">
  <section class="page-hero"><div class="container page-hero-inner"><div class="page-hero-copy"><div class="breadcrumb"><a href={route('/parroquias')}>Parroquias</a> <span>/ {parish.name}</span></div><span class="eyebrow-line"></span><h1>{parish.name},<br />unha parroquia <span class="accent">con futuro</span></h1><p>{parish.summary}</p><div class="hero-actions" style="margin-top:22px"><a class="button button-primary" href="#parish-proposals">Ver propostas <span>→</span></a><a class="text-link" href="#participation">Enviar unha proposta</a></div></div><div class="page-hero-media"><PlaceholderPhoto variant="parish" label={`Fotografía de ${parish.name} · pendente de substituír`} /></div></div></section>
  <section class="section"><div class="container"><SectionHeading title={`O que preocupa en ${parish.name}`} note="Cada parroquia conta." /><div class="area-grid">{parish.areas.map((area, index) => <div class="area-item">{index === 0 ? <Route size={29} /> : index === 1 ? <SprayCan size={29} /> : index === 2 ? <TreePine size={29} /> : <Landmark size={29} />}<strong>{area}</strong></div>)}</div></div></section>
  <section class="section soft"><div class="container"><SectionHeading title={`As nosas prioridades en ${parish.name}`} note="Unha parroquia mellor, entre todas e todos." /><div class="parish-priorities">{parish.priorities.map((priority) => <div class="parish-priority"><b>{priority.number}</b><h3>{priority.title}</h3><p>{priority.text}</p></div>)}</div></div></section>
  <section class="section parish-proposals" id="parish-proposals"><div class="container"><SectionHeading title={`Propostas para ${parish.name}`} note="Ideas reais para unha parroquia mellor." />{groups.length ? groups.map((group, index) => <ProposalAccordion categorySlug={group.category.slug} items={group.items} open={index === 0} showRows />) : <p class="empty-note">Aínda non hai propostas de demostración asociadas a esta parroquia.</p>}</div></section>
  <section class="section"><div class="container"><SectionHeading title={`${parish.name} no centro do proxecto`} note="Territorio. Xente. Futuro." /><div class="team-note"><PlaceholderPhoto variant="parish" label={`Mapa e fotografía de ${parish.name} · pendentes de substituír`} /><div><h3 style="font-family:Manrope,sans-serif;font-size:24px;margin-top:0">Unha parroquia con máis vida</h3><p class="empty-note">Aquí poderán aparecer puntos de atención, necesidades detectadas e propostas activas cando se incorpore o contido real.</p></div></div></div></section>
  <section class="participation" id="participation"><div class="container participation-layout"><div class="participation-copy"><h2>Tes algo que dicir sobre {parish.name}?</h2><p>A túa idea tamén conta. Comparte connosco as túas inquietanzas e axúdanos a construír un mellor {parish.name}.</p></div><ContactForm context={parish.name} /><div class="footer-mark">Entre todas<br />e todos,<br />un mellor<br />O Saviñao</div></div></section>
</BaseLayout>
